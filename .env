# SMTP 邮件服务器配置
# 示例使用 QQ 邮箱，如需使用其他邮箱请修改以下配置

# SMTP 服务器地址
SMTP_HOST=smtp.qq.com

# SMTP 端口 (465 for SSL, 587 for TLS)
SMTP_PORT=465

# 是否使用 SSL
SMTP_SECURE=true

# 发件人邮箱账号
SMTP_USER=your_email@qq.com

# 邮箱授权码（不是登录密码）
# QQ邮箱获取方式：设置 -> 账户 -> POP3/IMAP/SMTP/Exchange/CardDAV/CalDAV服务 -> 开启服务并获取授权码
SMTP_PASS=your_auth_code

# 发件人显示名称
SMTP_FROM=Funnel Insight <your_email@qq.com>
